# Infrastructure Environment Variables Template
# Copy this file to .env (or set these in your shell) before running deployment

# =============================================================================
# REQUIRED: Hetzner Cloud API Token
# =============================================================================
# Get your token from: https://console.hetzner.cloud/projects
# Required for all Terraform operations
export HCLOUD_TOKEN="your-hetzner-cloud-token-here"

# =============================================================================
# REQUIRED: Save Object Store Credentials
# =============================================================================
# These will be used as the S3-compatible access credentials
# Choose strong, unique values for production use
export SAVE_ACCESS_KEY="your-access-key-here"
export SAVE_SECRET_KEY="your-secret-key-here"

# =============================================================================
# OPTIONAL: Grafana Admin Password
# =============================================================================
# Default is "changeme" if not set
# Strongly recommended to set a secure password for production
export GRAFANA_PASSWORD="your-grafana-password-here"

# =============================================================================
# OPTIONAL: SSH Configuration
# =============================================================================
# Path to SSH public key (default: ~/.ssh/id_rsa.pub)
# export SSH_PUBLIC_KEY="$(cat ~/.ssh/id_rsa.pub)"

# =============================================================================
# OPTIONAL: Firewall IP Allowlist
# =============================================================================
# By default, only your current public IP will be allowed
# Add additional IPs/CIDR blocks (comma-separated) to allow more sources
# Example: export ALLOWED_SOURCE_IPS="203.0.113.0/24,198.51.100.5/32"
# export ALLOWED_SOURCE_IPS=""

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
#
# 1. Quick start (interactive prompts):
#    export HCLOUD_TOKEN="your-token"
#    ./deploy.sh medium
#
# 2. Non-interactive deployment:
#    source .env  # (after filling in values above)
#    ./deploy.sh large
#
# 3. Update existing deployment (Terraform auto-detects changes):
#    source .env
#    ./deploy.sh medium
#
# 4. Teardown:
#    ./teardown.sh
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# - NEVER commit this file with real credentials
# - .env.loadtest is auto-generated and also in .gitignore
# - Consider using a password manager or secrets management system
# - Rotate credentials regularly
# - Use strong, randomly generated passwords (e.g., `openssl rand -base64 32`)
#
